# Copy this file to .env and fill in your real key before running the server.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Current recommended model as of Sept 2026. Check https://platform.claude.com/docs/en/about-claude/models/overview
# if you want a different one (e.g. claude-haiku-4-6 for a cheaper/faster agent).
ANTHROPIC_MODEL=claude-sonnet-4-6

PORT=8787

# Shown to customers in system messages / used in the demo UI.
BUSINESS_NAME=Lumen Cycles
ANTHROPIC_WORKSPACE_ID=
